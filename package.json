{
  "name": "mms-platform",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:types": "supabase gen types typescript --local --schema public > packages/db/src/database.types.ts",
    "verify:slice": "node scripts/verify-slice.mjs",
    "check:docs": "node scripts/check-docs.mjs && node scripts/gen-menu-reference.mjs --check",
    "check:theme": "node scripts/check-theme-parity.mjs"
  },
  "devDependencies": {
    "@mms/config": "workspace:*",
    "turbo": "^2.9.18",
    "typescript": "^6.0.3",
    "@types/node": "^24.9.3",
    "eslint": "^9.39.4",
    "prettier": "^3.8.4",
    "knip": "^6.17.1"
  }
}
