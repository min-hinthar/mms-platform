{
  "name": "mms-platform",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "db:types": "supabase gen types typescript --linked > packages/db/src/types.gen.ts"
  },
  "devDependencies": {
    "@mms/config": "workspace:*",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3",
    "@types/node": "^22.9.0",
    "eslint": "^9.15.0",
    "prettier": "^3.3.3",
    "knip": "^5.36.0",
    "@eslint/eslintrc": "^3.2.0",
    "eslint-config-next": "16.1.2"
  },
  "pnpm": {
    "overrides": {
      "next": "16.1.2",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  }
}
