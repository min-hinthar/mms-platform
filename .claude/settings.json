{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/learning-context.mjs" }] }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/format.mjs" }]
      }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node .claude/hooks/session-retro.mjs" }] }
    ]
  }
}
