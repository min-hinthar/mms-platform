{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=ukuzkhuppqwtrdkjqrkv"
    },
    "github": {
      "command": "npx.cmd",
      "args": ["-y", "@modelcontextprotocol/server-github@latest"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${GH_TOKEN}" }
    },
    "sentry": {
      "command": "npx.cmd",
      "args": [
        "-y",
        "@sentry/mcp-server@latest",
        "--access-token",
        "${SENTRY_AUTH_TOKEN}",
        "--organization-slug",
        "${SENTRY_ORG}",
        "--project-slug",
        "${SENTRY_PROJECT}"
      ]
    }
  }
}
