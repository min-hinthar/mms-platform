{
  "name": "@mms/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "//sideEffects": "All modules are pure (the only side-effectful file is tokens.css, kept in the list) — lets the bundler tree-shake the barrel so framer-motion (via interactions.ts) doesn't ride into chunks that only import a framer-free primitive like Badge.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.17",
    "@number-flow/react": "^0.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.1",
    "lucide-react": "^0.562.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "@types/node": "^24.9.3",
    "@types/react": "^19.2.17",
    "@mms/config": "workspace:*",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "vitest": "4.0.17"
  }
}
