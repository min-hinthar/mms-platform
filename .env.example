# Copy to apps/qr/.env.local and fill in. NEVER commit real values.

# Supabase — QR has its OWN project (ref fasnpdhtvqtzjlvruqcu, "MMS QR Platform"); the delivery app
# runs on a separate project. Anonymous sign-ins must be enabled on this project (Auth → Providers).
NEXT_PUBLIC_SUPABASE_URL=https://fasnpdhtvqtzjlvruqcu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # new-style publishable key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # server-only; never sent to the client

# Stripe (test keys to start; never commit live keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# whsec from the webhook endpoint you create (Stripe → Developers → Webhooks → /api/stripe/webhook,
# events: payment_intent.succeeded + payment_intent.payment_failed). Local dev: `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints a temporary one.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2026-05-27.dahlia   # optional override; defaults to the SDK's pinned version

# PostHog (free tier; choose EU or US host deliberately)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
