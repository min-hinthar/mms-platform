# Copy to apps/qr/.env.local and fill in. NEVER commit real values.

# Supabase — QR has its OWN project (ref fasnpdhtvqtzjlvruqcu, "MMS QR Platform"); the delivery app
# runs on a separate project. Anonymous sign-ins must be enabled on this project (Auth → Providers).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_QR_PROJECT.supabase.co   # QR project ref: fasnpdhtvqtzjlvruqcu
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx   # new-style publishable key
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx            # server-only; never sent to the client

# Stripe (test keys to start; never commit live keys)
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# whsec from the webhook endpoint you create (Stripe → Developers → Webhooks → /api/stripe/webhook,
# events: payment_intent.succeeded + payment_intent.payment_failed). Local dev: `stripe listen
# --forward-to localhost:3000/api/stripe/webhook` prints a temporary one.
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_API_VERSION=2026-05-27.dahlia   # optional override; defaults to the SDK's pinned version

# PostHog (free tier; choose EU or US host deliberately)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Order-ready board (W3e) — the device token that authorizes the smart TV's sanitized /api/board poll.
# Generate something long + random (e.g. `openssl rand -base64 32`); the TV opens
# /board?k=<this value>. Unset ⇒ the board endpoint answers 503 (feature off).
BOARD_DEVICE_TOKEN=
KIOSK_DEVICE_TOKEN=
# W6c: the registered Stripe Terminal reader (tmr_…) the register's Card settle drives. MODE-
# SPECIFIC: a live-registered S700 doesn't exist in test mode — preview uses a simulated reader id.
# Unset ⇒ the Card settle is feature-off (no button; the action refuses).
STRIPE_TERMINAL_READER_ID=

# W23c — set to 1 to make PICKUP orders AUTHORIZE instead of charging, so the app gets one more look
# at the live catalog before money moves: it captures the reduced total when a dish ran out, or
# cancels the hold outright. A cancelled authorization leaves nothing on the guest's statement — a
# capture-then-refund leaves a charge and a reversal. Unset (or any other value) = pre-W23c behaviour.
PICKUP_MANUAL_CAPTURE=

# Email (Resend) — staff auth/lifecycle mail + the W7a diner receipt. Unset ⇒ email features are
# off (staff auth falls back per docs/ENV.md; the receipt email affordance simply doesn't render).
RESEND_API_KEY=
RESEND_FROM=
# W7a (C8): the diner-facing receipt sender — a customer receipt deserves its own identity.
# Falls back to RESEND_FROM while unset.
RESEND_RECEIPT_FROM=
RESEND_SIGNING_SECRET=
